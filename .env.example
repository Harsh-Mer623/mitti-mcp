# Mitti API Token (required) — Mitti is the 2026 rebrand of SafetyCulture.
# Generate one from your organization's Mitti account settings.
MITTI_API_TOKEN=your_api_token_here

# Optional: override the API base URL (defaults to https://api.mitti.com,
# the long-term host). api.safetyculture.io still works with no announced
# shutoff date if you need to pin to it.
# MITTI_BASE_URL=https://api.mitti.com

# Legacy env var names (SAFETYCULTURE_API_TOKEN, SAFETYCULTURE_BASE_URL) are
# still read as a fallback if the MITTI_* ones above are not set.
